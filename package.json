    "@testcontainers/postgresql": "^12.0.4",
    "@types/express": "^5.0.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/opossum": "8.1.9",
    "@types/supertest": "^6.0.2",
    "dependency-cruiser": "18.1.0",
