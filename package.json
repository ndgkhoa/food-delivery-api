{
  "name": "food-delivery-api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "nx build catalog",
    "test": "nx run-many -t test",
    "test:e2e": "nx run-many -t e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "cruiser": "depcruise apps libs --config .dependency-cruiser.js",
    "knip": "knip --no-config-hints",
    "typeorm": "TS_NODE_PROJECT=apps/catalog/tsconfig.app.json node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm run typeorm migration:generate -d apps/catalog/src/infrastructure/persistence/data-source.ts",
    "migration:run": "pnpm run typeorm migration:run -d apps/catalog/src/infrastructure/persistence/data-source.ts",
    "migration:revert": "pnpm run typeorm migration:revert -d apps/catalog/src/infrastructure/persistence/data-source.ts",
    "docker:core:up": "docker compose -f infra/docker-compose.yml --profile core up -d",
    "docker:core:down": "docker compose -f infra/docker-compose.yml --profile core down"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.22.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/webpack": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@swc/helpers": "~0.5.18",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/express": "^5.0.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "dependency-cruiser": "18.1.0",
    "dotenv": "^17.4.2",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "knip": "6.29.0",
    "lefthook": "2.1.10",
    "nx": "23.1.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.4.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.3.0",
    "typescript": "5.9.3",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  }
}
