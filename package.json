{
  "name": "food-delivery-api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "nx run-many -t serve -p gateway catalog auth inventory order payment search delivery",
    "build": "nx build catalog",
    "test": "nx run-many -t test",
    "test:e2e": "nx run-many -t e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "cruiser": "depcruise apps libs --config .dependency-cruiser.js",
    "knip": "knip --no-config-hints",
    "typeorm": "tsx --tsconfig tsconfig.base.json ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm run typeorm migration:generate -d apps/catalog/src/infrastructure/persistence/data-source.ts",
    "migration:run": "pnpm run typeorm migration:run -d apps/catalog/src/infrastructure/persistence/data-source.ts",
    "migration:revert": "pnpm run typeorm migration:revert -d apps/catalog/src/infrastructure/persistence/data-source.ts",
    "migration:auth:generate": "pnpm run typeorm migration:generate -d apps/auth/src/infrastructure/persistence/data-source.ts",
    "migration:auth:run": "pnpm run typeorm migration:run -d apps/auth/src/infrastructure/persistence/data-source.ts",
    "migration:auth:revert": "pnpm run typeorm migration:revert -d apps/auth/src/infrastructure/persistence/data-source.ts",
    "migration:inventory:generate": "pnpm run typeorm migration:generate -d apps/inventory/src/infrastructure/persistence/data-source.ts",
    "migration:inventory:run": "pnpm run typeorm migration:run -d apps/inventory/src/infrastructure/persistence/data-source.ts",
    "migration:inventory:revert": "pnpm run typeorm migration:revert -d apps/inventory/src/infrastructure/persistence/data-source.ts",
    "migration:order:generate": "pnpm run typeorm migration:generate -d apps/order/src/infrastructure/persistence/data-source.ts",
    "migration:order:run": "pnpm run typeorm migration:run -d apps/order/src/infrastructure/persistence/data-source.ts",
    "migration:order:revert": "pnpm run typeorm migration:revert -d apps/order/src/infrastructure/persistence/data-source.ts",
    "migration:payment:generate": "pnpm run typeorm migration:generate -d apps/payment/src/infrastructure/persistence/data-source.ts",
    "migration:payment:run": "pnpm run typeorm migration:run -d apps/payment/src/infrastructure/persistence/data-source.ts",
    "migration:payment:revert": "pnpm run typeorm migration:revert -d apps/payment/src/infrastructure/persistence/data-source.ts",
    "db:migrate": "DB_NAME=catalog pnpm migration:run && DB_NAME=auth pnpm migration:auth:run && DB_NAME=inventory pnpm migration:inventory:run && DB_NAME=order pnpm migration:order:run && DB_NAME=payment pnpm migration:payment:run",
    "docker:core:up": "docker compose --env-file .env -f infra/docker-compose.yml --profile core up -d",
    "docker:core:down": "docker compose --env-file .env -f infra/docker-compose.yml --profile core down"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "1.10.0",
    "@elastic/elasticsearch": "9.4.2",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "11.1.28",
    "@scalar/nestjs-api-reference": "^1.2.11",
    "@socket.io/redis-adapter": "8.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.22.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "4.8.3",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/webpack": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@swc/helpers": "~0.5.18",
    "@testcontainers/kafka": "12.0.4",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/express": "^5.0.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "dependency-cruiser": "18.1.0",
    "dotenv": "^17.4.2",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "knip": "6.29.0",
    "lefthook": "2.1.10",
    "nx": "23.1.0",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "4.8.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.4.7",
    "tslib": "^2.3.0",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  }
}
