# shellcheck disable=SC2034
# Copy to `.env` for local development. Never commit the real `.env` (gitignored).

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=catalog

REDIS_PORT=6379

# API gateway (edge) — stateless, no DB
CATALOG_SERVICE_URL=http://localhost:3001
JWKS_URI=http://localhost:8080/realms/food-delivery/protocol/openid-connect/certs
JWT_ISSUER=http://localhost:8080/realms/food-delivery
JWT_AUDIENCE=food-delivery-api
JWT_CLOCK_TOLERANCE_SEC=5

# Nginx edge host ports
HTTP_PORT=80
HTTPS_PORT=443
