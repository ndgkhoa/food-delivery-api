# shellcheck disable=SC2034 disable=SC2209
# Copy to `.env` for local development. Never commit the real `.env` (gitignored).

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=catalog

REDIS_PORT=6379
# ioredis connection for the inventory distributed lock (shared-locking).
REDIS_URL=redis://localhost:6379

# gRPC east-west endpoints (internal only — never exposed via Nginx). Catalog runs
# a hybrid app (HTTP on PORT + gRPC here); inventory is gRPC-only.
CATALOG_GRPC_URL=0.0.0.0:50051
INVENTORY_GRPC_URL=0.0.0.0:50052

# inventory service — gRPC-only stock/reservation owner. Lives in the SAME core
# Postgres (port 5432) under its own database `inventory` (auto-created on first
# `docker compose up`). Run its migrations with DB_NAME=inventory:
#   DB_NAME=inventory pnpm migration:inventory:run
#   DB_NAME=inventory pnpm nx serve inventory

# order service — HTTP-only (PORT 3003), calls catalog + inventory as a gRPC
# CLIENT (CATALOG_GRPC_URL / INVENTORY_GRPC_URL above). Lives in the SAME core
# Postgres (port 5432) under its own database `order` (auto-created on first up):
#   DB_NAME=order pnpm migration:order:run
#   DB_NAME=order PORT=3003 pnpm nx serve order

# API gateway (edge) — stateless, no DB
CATALOG_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
# Keycloak base URL + realm; issuer and JWKS endpoint are derived from these.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=food-delivery
JWT_AUDIENCE=food-delivery-api
JWT_CLOCK_TOLERANCE_SEC=5
# Public PKCE client the session proxy (/api/v1/auth token|refresh|logout) uses.
KEYCLOAK_SPA_CLIENT_ID=food-delivery-spa

# Per-identity rate limiting (fixed window in Redis). Keyed by the verified `sub`
# on authenticated routes, falling back to client IP on public ones. Over the
# threshold → 429 with Retry-After. Disable only in container-less test envs.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60
REDIS_URL=redis://localhost:6379

# auth service (tenant registry) — lives in the SAME core Postgres (port 5432)
# under its own database `auth` (auto-created on first up). It reads the standard
# DB_* vars, so run the auth service/migrations with DB_NAME=auth (the DB_NAME
# above belongs to catalog).
#   DB_NAME=auth pnpm migration:auth:run
#   DB_NAME=auth pnpm nx serve auth
# The auth admin-client authenticates with KEYCLOAK_URL + KEYCLOAK_ADMIN /
# KEYCLOAK_ADMIN_PASSWORD (the bootstrap creds defined in the `auth` block below).

# Keycloak (`auth` compose profile) — dev-only bootstrap creds + its own Postgres.
# KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD are REQUIRED (no schema default): the
# auth service fails to boot if unset, so a real deployment can never silently
# fall back to admin/admin. These dev values are convenience only — override them
# (and use strong secrets) outside local development.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak

# Nginx edge host ports
HTTP_PORT=80
HTTPS_PORT=443
