# shellcheck disable=SC2034 disable=SC2209

# --- Application ---

NODE_ENV=development
LOG_LEVEL=debug

# --- Database ---

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=abc123456

# Read replica (optional)
DB_REPLICA_PORT=5433
REPLICATION_USERNAME=replicator
REPLICATION_PASSWORD=replicator

# --- Redis ---

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60

# --- Kafka ---

KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=food-delivery

# --- gRPC ---

CATALOG_GRPC_URL=0.0.0.0:50051
INVENTORY_GRPC_URL=0.0.0.0:50052

# --- Authentication ---

JWT_AUDIENCE=food-delivery-api
JWT_CLOCK_TOLERANCE_SEC=5

KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=abc123456
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=abc123456
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=food-delivery
KEYCLOAK_SPA_CLIENT_ID=food-delivery-spa

# --- Observability ---

TELEMETRY_ENABLED=true

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_METRICS_PORT=8889

JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
LOKI_PORT=3100

GRAFANA_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Infrastructure Services ---

## Nginx
HTTP_PORT=80
HTTPS_PORT=443

## Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=payment-charges

TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

TEMPORAL_DB_USERNAME=temporal
TEMPORAL_DB_PASSWORD=temporal

## Elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_NODE=http://localhost:9200

## MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

MEDIA_BUCKET=media

## ClickHouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=analytics

## Debezium
CONNECT_URL=http://localhost:8083
DEBEZIUM_DB_USERNAME=debezium
DEBEZIUM_DB_PASSWORD=debezium

# --- Business Services ---

## Config
CONFIG_CACHE_TTL_MS=30000

## Payment
PORT=3007
PAYMENT_STUB_FAIL_AT_CENTS=66600
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret

## Order
SAGA_REAPER_TIMEOUT_MS=60000
SAGA_REAPER_INTERVAL_MS=30000

## Delivery
DRIVER_LOCATION_RATE_LIMIT_PER_SEC=5
NEARBY_RADIUS_M=3000

## Media
PRESIGN_TTL_SECONDS=300
MAX_UPLOAD_BYTES=5000000

ALLOWED_MIME=image/jpeg,image/png,image/webp
THUMBNAIL_WIDTH=200

## Notification
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=notifications@food-delivery.test

NOTIFY_MAX_ATTEMPTS=5
NOTIFY_BACKOFF_MS=2000

NOTIFY_EMAIL_ENABLED=true
NOTIFY_SMS_ENABLED=true
NOTIFY_PUSH_ENABLED=true

# --- API Gateway ---

CATALOG_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
SEARCH_SERVICE_URL=http://localhost:3004
DELIVERY_SERVICE_URL=http://localhost:3005
MEDIA_SERVICE_URL=http://localhost:3006
CONFIG_SERVICE_URL=http://localhost:3008
REVIEW_SERVICE_URL=http://localhost:3009
ANALYTICS_SERVICE_URL=http://localhost:3010

# --- Gateway Circuit Breaker ---

CB_ENABLED=true
CB_ERROR_THRESHOLD_PERCENT=50
CB_RESET_TIMEOUT_MS=10000
CB_ROLLING_WINDOW_MS=10000
CB_VOLUME_THRESHOLD=5
