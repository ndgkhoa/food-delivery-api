# shellcheck disable=SC2034 disable=SC2209

# Application
NODE_ENV=development
LOG_LEVEL=debug

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=abc123456

# Nginx
HTTP_PORT=80
HTTPS_PORT=443

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60

# Kafka (messaging profile — libs/shared/messaging)
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
# Each service passes its own value to MessagingModule.forRoot({ clientId: ... }),
# e.g. KAFKA_CLIENT_ID=catalog / order / inventory / payment — shows up in broker logs/metrics.
KAFKA_CLIENT_ID=food-delivery

# Payment stub (order saga). The order total (in cents) the deterministic stub
# DECLINES so the compensation path can be triggered without randomness; every
# other amount succeeds.
PAYMENT_STUB_FAIL_AT_CENTS=66600

# Stranded-saga reaper (order service). A saga idle in a non-terminal state
# longer than SAGA_REAPER_TIMEOUT_MS is reported by the sweep that runs every
# SAGA_REAPER_INTERVAL_MS (discovery-only; timeout-driven recovery is later).
SAGA_REAPER_TIMEOUT_MS=60000
SAGA_REAPER_INTERVAL_MS=30000

# Debezium CDC (messaging profile — infra/debezium). Kafka Connect REST + the
# least-privilege replication role the catalog outbox connector authenticates as.
# Register the connector after boot: ./infra/debezium/register-connectors.sh
CONNECT_URL=http://localhost:8083
DEBEZIUM_DB_USERNAME=debezium
DEBEZIUM_DB_PASSWORD=debezium

# gRPC
CATALOG_GRPC_URL=0.0.0.0:50051
INVENTORY_GRPC_URL=0.0.0.0:50052

# Elasticsearch (search profile — apps/search). Single-node dev cluster; the
# search service bootstraps the `restaurants` index on boot (no SQL migration).
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_NODE=http://localhost:9200

# API gateway
CATALOG_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
SEARCH_SERVICE_URL=http://localhost:3004

# JWT
JWT_AUDIENCE=food-delivery-api
JWT_CLOCK_TOLERANCE_SEC=5

# Keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=abc123456
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=abc123456
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=food-delivery
KEYCLOAK_SPA_CLIENT_ID=food-delivery-spa
