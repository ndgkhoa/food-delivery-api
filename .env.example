# shellcheck disable=SC2034 disable=SC2209
# Copy to `.env` for local development. Never commit the real `.env` (gitignored).

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=catalog

REDIS_PORT=6379

# API gateway (edge) — stateless, no DB
CATALOG_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3002
# Keycloak base URL + realm; issuer and JWKS endpoint are derived from these.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=food-delivery
JWT_AUDIENCE=food-delivery-api
JWT_CLOCK_TOLERANCE_SEC=5

# auth service (tenant registry) — lives in the SAME core Postgres (port 5432)
# under its own database `auth`. It reads the standard DB_* vars, so run the auth
# service/migrations with DB_NAME=auth (the DB_NAME above belongs to catalog).
# Create the database once:  createdb -h localhost -U postgres auth
#   DB_NAME=auth pnpm nx serve auth
#   DB_NAME=auth pnpm migration:auth:run
# The auth admin-client authenticates with KEYCLOAK_URL + KEYCLOAK_ADMIN /
# KEYCLOAK_ADMIN_PASSWORD (the bootstrap creds defined in the `auth` block below).

# Keycloak (`auth` compose profile) — dev-only bootstrap creds + its own Postgres
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak

# Nginx edge host ports
HTTP_PORT=80
HTTPS_PORT=443
