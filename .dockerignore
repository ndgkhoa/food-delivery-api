# Keeps the Docker build context small and the builder-stage cache stable —
# none of this is needed to build or run a service image.
node_modules
dist
coverage
tmp
.nx
.git
.github

# Local env / secrets — never bake these into an image.
.env
.env.*
!.env.example

# Plans, docs, and non-runtime tooling.
plans
docs
bruno
*.md

# e2e projects build/run separately from the runtime image.
**/*-e2e

# Editor/OS cruft.
.vscode
.idea
.DS_Store
*.log
