{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@food-delivery-api/shared-config": ["libs/shared/config/src/index.ts"],
      "@food-delivery-api/shared-logging": ["libs/shared/logging/src/index.ts"],
      "@food-delivery-api/shared-jwt": ["libs/shared/jwt/src/index.ts"],
      "@food-delivery-api/shared-jwt/testing": ["libs/shared/jwt/src/testing/test-jwks.ts"],
      "@food-delivery-api/shared-tenancy": ["libs/shared/tenancy/src/index.ts"],
      "@food-delivery-api/shared-contracts": ["libs/shared/contracts/src/index.ts"],
      "@food-delivery-api/shared-locking": ["libs/shared/locking/src/index.ts"],
      "@food-delivery-api/shared-messaging": ["libs/shared/messaging/src/index.ts"],
      "@auth/*": ["apps/auth/src/*"],
      "@catalog/*": ["apps/catalog/src/*"],
      "@gateway/*": ["apps/gateway/src/*"],
      "@inventory/*": ["apps/inventory/src/*"],
      "@order/*": ["apps/order/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
