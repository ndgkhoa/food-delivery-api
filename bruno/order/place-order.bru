meta {
  name: Place order
  type: http
  seq: 1
}

post {
  url: {{gateway}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "items": [
      { "itemId": "REPLACE_WITH_A_MENU_ITEM_UUID", "qty": 2 }
    ]
  }
}

docs {
  Run Auth > Login (customer) first. `Idempotency-Key` is required — {{$guid}}
  generates a fresh one per send (retry with the SAME key to see idempotent
  replay). The itemId must be a real menu item that also has an inventory stock
  row, or the reserve step returns InsufficientStock (409).
}
