meta {
  name: Tenant - create
  type: http
  seq: 1
}

post {
  url: {{gateway}}/auth/tenants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Acme Foods",
    "slug": "acme-foods"
  }
}

docs {
  Admin only. Log in as admin first, then copy the returned id into the tenantId param below.
}
