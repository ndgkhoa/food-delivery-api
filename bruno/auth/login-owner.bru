meta {
  name: Login (owner)
  type: http
  seq: 1
}

post {
  url: {{keycloak}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{client}}
  username: owner-user
  password: owner-pass
}

script:post-response {
  if (res.body && res.body.access_token) {
    bru.setEnvVar("token", res.body.access_token);
  }
}

docs {
  Direct-grant login for the seeded `owner-user` (restaurant-owner). Saves the
  access token into the `token` env var so every other request can send it as a
  Bearer. Run this first, then any request below.
}
