meta {
  name: Login (customer)
  type: http
  seq: 2
}

post {
  url: {{keycloak}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{client}}
  username: demo-acme-customer
  password: demo-acme-Customer1!
}

script:post-response {
  if (res.body && res.body.access_token) {
    bru.setEnvVar("token", res.body.access_token);
    bru.setEnvVar("refreshToken", res.body.refresh_token);
  }
}
