meta {
  name: Login (admin)
  type: http
  seq: 3
}

post {
  url: {{keycloak}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{client}}
  username: admin-user
  password: admin-pass
}

script:post-response {
  if (res.body && res.body.access_token) {
    bru.setEnvVar("token", res.body.access_token);
    bru.setEnvVar("refreshToken", res.body.refresh_token);
  }
}
